# App
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/proofresponse

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Email - preferred option: SMTP2GO API
SMTP2GO_API_KEY=
SMTP2GO_FROM_EMAIL=
SMTP2GO_FROM_NAME=GetPaid Workshop

# Email - fallback option: generic SMTP
# For Gmail personal accounts, use:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=your@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM=your@gmail.com
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# Optional media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# GoHighLevel / LeadConnector external tracking (form + page view capture)
NEXT_PUBLIC_GHL_TRACKING_ID=tk_94c47a1009ed40ffb4213433322394f3
# Set to true to log tracking activity in the browser console (enabled by default in development)
NEXT_PUBLIC_GHL_TRACKING_DEBUG=true

# Google reCAPTCHA v2 Invisible
# Get keys: https://www.google.com/recaptcha/admin
# Add domains: localhost, getpaidclients.in
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
